# =============================================================
#  Mawid — Django Backend  (.env.example)
#  Copy to .env and fill in your values.
#  Production: set DATABASE_URL, DEBUG=False, and a strong SECRET_KEY.
# =============================================================

# --------------------------
#  Django core
# --------------------------
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=.railway.app,.vercel.app,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=api.settings


# --------------------------
#  Database (Neon PostgreSQL)
#  DATABASE_URL takes priority — set this in Railway dashboard.
#  Fallback vars below are for local dev only.
# --------------------------
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.neon.tech/neondb?sslmode=require

DB_NAME=mawid_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# --------------------------
#  JWT (djangorestframework-simplejwt)
# --------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7


# --------------------------
#  CORS — add your frontend domain(s), comma-separated
# --------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000


# --------------------------
#  Cloudinary (media storage — optional)
#  Leave blank to store files locally (dev only)
# --------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --------------------------
#  Email
#  Dev: set BACKEND to console — emails print in terminal
#  Prod: set BACKEND to smtp and fill in the SMTP fields
# --------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=Mawid <no-reply@mawid.app>
