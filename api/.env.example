# =============================================================
#  Mawid — Django Backend
# =============================================================

# --------------------------
#  Django core
# --------------------------
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1


# --------------------------
#  Database (PostgreSQL)
# --------------------------
DB_NAME=mawid_dev
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432


# --------------------------
#  JWT (djangorestframework-simplejwt)
# --------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7


# --------------------------
#  CORS (django-cors-headers)
#  Dev: React runs on localhost:3000
#  Prod: replace with your real frontend domain
# --------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000


# --------------------------
#  Cloudinary (media storage — optional)
#  Get credentials at https://cloudinary.com/console
#  Leave blank to store files locally (dev only)
# --------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --------------------------
#  Email
#  Dev: set BACKEND to console — emails print in terminal
#  Prod: set BACKEND to smtp and fill in the SMTP fields
# --------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=Mawid <no-reply@mawid.app>